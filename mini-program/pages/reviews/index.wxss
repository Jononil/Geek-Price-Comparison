.rv-page {
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}
.post-card {
  margin-bottom: 24rpx;
}
.post-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}
.star-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
}
.star {
  font-size: 48rpx;
  color: #e5e7eb;
  padding: 0 8rpx;
}
.star-on {
  color: #f59e0b;
}
.star-hint {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #6b7280;
}
.post-input {
  width: 100%;
  min-height: 160rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  background: #fafafa;
}
.post-btn {
  margin-top: 20rpx;
}
.login-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.login-hint {
  font-size: 26rpx;
  color: #6b7280;
}
.login-btn {
  margin: 0;
}
.list-card {
  padding-bottom: 8rpx;
}
.list-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}
.total {
  font-size: 24rpx;
  color: #9ca3af;
  font-weight: 400;
}
.review-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}
.review-item:last-child {
  border-bottom: none;
}
.ri-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.ri-user {
  font-weight: 600;
  font-size: 26rpx;
}
.ri-star {
  color: #f59e0b;
  font-size: 22rpx;
}
.ri-time {
  margin-left: auto;
  color: #9ca3af;
  font-size: 20rpx;
}
.ri-content {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.6;
}
.load-more {
  padding: 24rpx 0;
}
.no-more {
  display: block;
  text-align: center;
  color: #cbd5e1;
  font-size: 22rpx;
}
