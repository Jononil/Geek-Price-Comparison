.rk-page {
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}
.tab-bar {
  display: flex;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 26rpx;
  color: #6b7280;
  border-bottom: 4rpx solid transparent;
}
.tab-active {
  color: #2563eb;
  font-weight: 700;
  border-bottom-color: #2563eb;
  background: #f8fbff;
}
.rank-list {
  padding: 8rpx 0;
}
.rank-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f1f5f9;
}
.rank-item:last-child {
  border-bottom: none;
}
.rank-num {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #e5e7eb;
  color: #6b7280;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 26rpx;
  flex-shrink: 0;
}
.rank-top {
  background: #2563eb;
  color: #ffffff;
}
.rank-img-wrap {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  background: #f8fafc;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.rank-img {
  width: 100%;
  height: 100%;
}
.rank-info {
  flex: 1;
  min-width: 0;
}
.rank-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.rank-meta {
  display: block;
  font-size: 20rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}
.rank-value {
  color: #10b981;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.rank-value-dim {
  color: #9ca3af;
  font-size: 22rpx;
  flex-shrink: 0;
}
.rank-price-wrap {
  flex-shrink: 0;
  text-align: right;
  min-width: 140rpx;
}
.rank-price {
  color: #f97316;
  font-weight: 700;
  font-size: 28rpx;
}
.rank-sim {
  font-size: 18rpx;
  color: #cbd5e1;
}
.footer-hint {
  text-align: center;
  margin-top: 24rpx;
}
