.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 48rpx 60rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #eef2ff 0%, #f5f7fa 40%);
}
.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 64rpx;
}
.brand-name {
  font-size: 52rpx;
  font-weight: 700;
  color: #4f46e5;
}
.brand-slogan {
  font-size: 24rpx;
  color: #6b7280;
}
.form {
  width: 100%;
  box-sizing: border-box;
  padding: 48rpx 40rpx;
}
.input {
  height: 96rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  margin-bottom: 28rpx;
  background: #fafafa;
}
.input:focus {
  background: #ffffff;
  border-color: #4f46e5;
}
.login-btn {
  margin-top: 8rpx;
}
.switch {
  text-align: center;
  margin-top: 32rpx;
  font-size: 26rpx;
  color: #4f46e5;
}
.footer-hint {
  margin-top: auto;
  padding-top: 48rpx;
}
