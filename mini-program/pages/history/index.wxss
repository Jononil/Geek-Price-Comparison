.his-page {
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}
.head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.head-count {
  font-size: 24rpx;
  color: #6b7280;
}
.head-clear {
  font-size: 24rpx;
  color: #ef4444;
}
.his-item {
  display: flex;
  margin-bottom: 20rpx;
  padding: 20rpx;
}
.hi-img-wrap {
  width: 140rpx;
  height: 140rpx;
  flex-shrink: 0;
  background: #f8fafc;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.hi-img {
  width: 100%;
  height: 100%;
}
.hi-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.hi-name {
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.hi-time {
  font-size: 20rpx;
  color: #9ca3af;
}
.hi-bottom {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.hi-value {
  color: #10b981;
  font-size: 22rpx;
}
.hi-value-dim {
  color: #9ca3af;
  font-size: 22rpx;
}
.hi-price {
  color: #f97316;
  font-weight: 700;
  font-size: 28rpx;
}
.hi-sim {
  font-size: 18rpx;
  color: #cbd5e1;
  font-weight: 400;
}
