.reg-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx 60rpx;
  box-sizing: border-box;
}
.reg-card {
  width: 100%;
  box-sizing: border-box;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
}
.reg-title {
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 40rpx;
}
.reg-input {
  height: 96rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  margin-bottom: 28rpx;
  background: #fafafa;
}
.reg-btn {
  margin-top: 8rpx;
}
.switch {
  text-align: center;
  margin-top: 32rpx;
  font-size: 26rpx;
  color: #4f46e5;
}
.footer-hint {
  margin-top: auto;
  padding-top: 48rpx;
}
