.cat-page {
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}
.all-entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.all-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #4f46e5;
}
.all-arrow {
  font-size: 32rpx;
  color: #4f46e5;
}
.cat-grid {
  display: flex;
  flex-direction: column;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: var(--gp-radius);
  overflow: hidden;
}
.cat-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 28rpx;
  border-bottom: 1rpx solid #f1f5f9;
}
.cat-item:last-child {
  border-bottom: none;
}
.cat-name {
  font-size: 28rpx;
  color: #1f2937;
}
.cat-arrow {
  font-size: 32rpx;
  color: #cbd5e1;
}
