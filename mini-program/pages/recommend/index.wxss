.rec-page {
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}
.intro {
  margin-bottom: 20rpx;
  text-align: center;
}
.rec-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}
.rec-card {
  width: 50%;
  padding: 8rpx;
  box-sizing: border-box;
}
.rc-img-wrap {
  position: relative;
  width: 100%;
  height: 240rpx;
  background: #f8fafc;
  border-radius: 12rpx 12rpx 0 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rc-img {
  width: 100%;
  height: 100%;
}
.rc-type {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  background: rgba(37, 99, 235, 0.9);
  color: #ffffff;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}
.rc-match {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #4f46e5;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 600;
}
.rc-body {
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-top: none;
  border-radius: 0 0 12rpx 12rpx;
  padding: 16rpx 20rpx;
}
.rc-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.rc-reason {
  display: block;
  font-size: 20rpx;
  color: #6b7280;
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.rc-footer {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 10rpx;
  padding-bottom: 8rpx;
}
.rc-price {
  color: #111827;
  font-weight: 700;
  font-size: 28rpx;
}
.rc-sim {
  font-size: 18rpx;
  color: #cbd5e1;
  font-weight: 400;
}
.rc-value {
  color: #15803d;
  font-size: 20rpx;
  font-weight: 600;
}
.rc-value-dim {
  color: #9ca3af;
  font-size: 20rpx;
}
.footer-hint {
  text-align: center;
  margin-top: 24rpx;
}
