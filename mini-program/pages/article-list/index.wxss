.al-page {
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}
.article-card {
  display: flex;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}
.cover-wrap {
  width: 220rpx;
  flex-shrink: 0;
  background: #f8fafc;
}
.cover {
  width: 100%;
  height: 100%;
  min-height: 200rpx;
}
.article-body {
  flex: 1;
  padding: 20rpx 24rpx;
  min-width: 0;
}
.title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.summary {
  display: block;
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 10rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
  flex-wrap: wrap;
}
.meta-item {
  font-size: 20rpx;
  color: #9ca3af;
}
.meta-dim {
  font-size: 20rpx;
  color: #cbd5e1;
}
.score {
  margin-left: auto;
  font-size: 22rpx;
  color: #2563eb;
  font-weight: 600;
}
.product-link {
  margin-left: auto;
  font-size: 20rpx;
  color: #2563eb;
}
.load-more {
  padding: 24rpx 0;
}
.no-more {
  display: block;
  text-align: center;
  color: #cbd5e1;
  font-size: 22rpx;
}
