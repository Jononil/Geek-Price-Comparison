<view class="home">
  <!-- 搜索入口 -->
  <view class="search-bar">
    <input
      class="search-input"
      placeholder="搜索手机、耳机、显卡、笔记本……"
      confirm-type="search"
      value="{{keyword}}"
      bindinput="onKeywordInput"
      bindconfirm="onSearch"
    />
    <view class="search-btn gp-btn-primary" bindtap="onSearch">智能比价</view>
  </view>

  <!-- 对比入口 -->
  <view class="compare-entry" bindtap="onGoCompare">
    <text>商品对比</text>
    <text class="compare-count" wx:if="{{compareCount > 0}}">{{compareCount}} 个商品待对比</text>
    <text class="compare-arrow">›</text>
  </view>

  <!-- 热门分类 -->
  <view class="section gp-card" wx:if="{{categories.length > 0}}">
    <view class="section-title">热门分类</view>
    <view class="category-grid">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="category-item"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
        bindtap="onGoCategory"
      >{{item.name}}</view>
    </view>
  </view>

  <!-- 高性价比严选 -->
  <view class="section gp-card">
    <view class="title-row">
      <text class="section-title">高性价比严选</text>
      <text class="more" bindtap="onGoAllValue">查看全部 ›</text>
    </view>
    <gp-loading wx:if="{{valueState === 'loading'}}" />
    <gp-error wx:elif="{{valueState === 'error'}}" bind:retry="onRetryValue" />
    <gp-empty wx:elif="{{valueProducts.length === 0}}" text="暂无商品" />
    <view wx:else class="product-grid">
      <view class="product-col" wx:for="{{valueProducts}}" wx:key="id">
        <gp-product-card product="{{item}}" />
      </view>
    </view>
  </view>

  <!-- 为你推荐 -->
  <view class="section gp-card">
    <view class="section-title">为你推荐</view>
    <gp-loading wx:if="{{recState === 'loading'}}" />
    <gp-error wx:elif="{{recState === 'error'}}" bind:retry="onRetryRec" />
    <gp-empty wx:elif="{{recommendations.length === 0}}" text="暂无推荐" />
    <view wx:else class="rec-grid">
      <view
        wx:for="{{recommendations}}"
        wx:key="productId"
        class="rec-card"
        data-id="{{item.productId}}"
        bindtap="onGoDetail"
      >
        <view class="rec-img-wrap">
          <image wx:if="{{item.image}}" class="rec-img" src="{{item.image}}" mode="aspectFit" lazy-load />
          <gp-no-image wx:else size="{{60}}" text="" />
          <text class="rec-type">{{item.typeLabel}}</text>
        </view>
        <text class="rec-name">{{item.name}}</text>
        <text class="rec-reason">💡 {{item.reason}}</text>
        <view class="rec-footer">
          <text class="rec-price">¥{{item.priceText}}</text>
          <text wx:if="{{item.valueMissing}}" class="rec-value-dim">数据不足</text>
          <text wx:else class="rec-value">性价比 {{item.valueScore}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="footer-hint gp-data-hint">当前价格与历史价格均为系统模拟报价，非实时电商价格</view>
</view>
