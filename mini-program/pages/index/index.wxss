.home {
  padding: var(--gp-page-pad);
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* ---- 深色 Hero ---- */
.hero {
  margin-bottom: 24rpx;
}
.search-bar {
  display: flex;
  gap: 12rpx;
  margin-top: 28rpx;
}
.search-input {
  flex: 1;
  height: 84rpx;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 20rpx;
  padding: 0 26rpx;
  font-size: 26rpx;
  color: #1f2937;
}
.search-ph {
  color: #9ca3af;
}
.search-btn {
  flex-shrink: 0;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 30rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #6366f1, #0891b2);
  box-shadow: 0 12rpx 28rpx -12rpx rgba(99, 102, 241, 0.9);
}
.hero-caps {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}
.cap {
  font-size: 22rpx;
  color: #cdd8ea;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

/* ---- 对比入口 ---- */
.compare-entry {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--gp-primary-light);
  border: 1rpx solid #c7d2fe;
  border-radius: var(--gp-radius);
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}
.compare-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--gp-primary);
}
.compare-count {
  font-size: 22rpx;
  color: var(--gp-text-sub);
}
.compare-arrow {
  margin-left: auto;
  font-size: 32rpx;
  color: var(--gp-primary);
}

/* ---- 分类胶囊 ---- */
.cats {
  margin-bottom: 24rpx;
}
.chip-scroll {
  width: 100%;
  white-space: nowrap;
}
.chip-row {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 0;
}

/* ---- 区块 ---- */
.section {
  margin-bottom: 32rpx;
}
.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.section-title {
  font-size: var(--gp-font-lg);
  font-weight: 700;
}
.more {
  font-size: 24rpx;
  color: var(--gp-primary);
  font-weight: 600;
}

/* ---- 商品双列 ---- */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 20rpx -8rpx 0;
}
.product-col {
  width: 50%;
  padding: 8rpx;
  box-sizing: border-box;
}

/* ---- 推荐 ---- */
.rec-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 20rpx -8rpx 0;
}
.rec-card {
  width: 50%;
  padding: 8rpx;
  box-sizing: border-box;
}
.rec-img-wrap {
  position: relative;
  width: 100%;
  height: 240rpx;
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
  background: linear-gradient(150deg, #fbfcfe, #e9eef6);
  display: flex;
  align-items: center;
  justify-content: center;
}
.rec-img {
  width: 100%;
  height: 100%;
}
.rec-type {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  background: rgba(79, 70, 229, 0.92);
  color: #ffffff;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
}
.rec-body {
  background: var(--gp-card-bg);
  border: 1rpx solid var(--gp-border);
  border-top: none;
  border-radius: 0 0 24rpx 24rpx;
  padding: 16rpx 20rpx 20rpx;
  box-shadow: var(--gp-shadow);
}
.rec-name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.rec-reason {
  display: block;
  font-size: 20rpx;
  color: var(--gp-text-sub);
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.rec-footer {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 12rpx;
}
.rec-price {
  color: var(--gp-price);
  font-weight: 800;
  font-size: 32rpx;
}
.rec-value {
  color: var(--gp-value);
  font-size: 20rpx;
  font-weight: 700;
  background: #ecfdf5;
  border: 1rpx solid #bbf7d0;
  border-radius: 10rpx;
  padding: 2rpx 12rpx;
}
.rec-value-dim {
  color: var(--gp-text-dim);
  font-size: 20rpx;
}

.footer-hint {
  text-align: center;
  margin-top: 16rpx;
}
