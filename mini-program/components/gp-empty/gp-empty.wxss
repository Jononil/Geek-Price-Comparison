/* 中性空态：通用"空/缺失"图标（相框+斜杠），与任何商品类别无关，不伪装有内容 */
.gp-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx;
  gap: 12rpx;
}
.icon-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 8rpx;
}
.icon-box {
  position: absolute;
  left: 8rpx;
  top: 14rpx;
  width: 80rpx;
  height: 62rpx;
  border: 4rpx solid #cbd5e1;
  border-radius: 8rpx;
  box-sizing: border-box;
}
.icon-slash {
  position: absolute;
  left: 50%;
  top: 8rpx;
  width: 4rpx;
  height: 88rpx;
  background: #cbd5e1;
  transform: translateX(-50%) rotate(40deg);
  border-radius: 2rpx;
}
.text {
  font-size: 26rpx;
  color: #9ca3af;
  letter-spacing: 1rpx;
}
.sub {
  font-size: 22rpx;
  color: #cbd5e1;
  text-align: center;
}
.slot {
  margin-top: 16rpx;
}
