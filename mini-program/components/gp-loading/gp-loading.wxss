/* 中性加载态：轻量 spinner，无夸张动画 */
.gp-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  gap: 16rpx;
}
.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 5rpx solid #dbe4f5;
  border-top-color: #2563eb;
  border-radius: 50%;
  animation: gp-spin 0.9s linear infinite;
}
@keyframes gp-spin {
  to { transform: rotate(360deg); }
}
.text {
  font-size: 24rpx;
  color: #9ca3af;
}
