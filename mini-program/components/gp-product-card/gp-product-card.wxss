.card {
  background: var(--gp-card-bg);
  border: 1rpx solid var(--gp-border);
  border-radius: var(--gp-radius);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: var(--gp-shadow);
}
.image-wrap {
  position: relative;
  width: 100%;
  height: 280rpx;
  background: linear-gradient(150deg, #fbfcfe, #e9eef6);
  overflow: hidden;
}
.img {
  width: 100%;
  height: 100%;
}
.tags {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  display: flex;
  gap: 8rpx;
  z-index: 2;
}
.tag {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
}
.tag-value {
  background: #ecfdf5;
  color: var(--gp-value);
  border: 1rpx solid #bbf7d0;
}
.tag-discount {
  background: #fffbeb;
  color: var(--gp-warning);
  border: 1rpx solid #fde68a;
}
.info-btn {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  z-index: 3;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  color: #64748b;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.12);
}
.info {
  padding: 20rpx 20rpx 8rpx;
  flex: 1;
}
.name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--gp-text-main);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: 2.8em;
}
.brand {
  display: block;
  font-size: 22rpx;
  color: var(--gp-text-dim);
  margin-top: 8rpx;
}
.meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 14rpx;
}
.value {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--gp-value);
  background: #ecfdf5;
  border: 1rpx solid #bbf7d0;
  border-radius: 10rpx;
  padding: 2rpx 12rpx;
}
.value-dim {
  color: var(--gp-text-dim);
  background: #f3f4f6;
  border-color: var(--gp-border);
  font-weight: 500;
}
.rating {
  font-size: 22rpx;
  color: var(--gp-text-sub);
}
.price-row {
  margin-top: 12rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 10rpx;
}
.price-label {
  font-size: 20rpx;
  color: var(--gp-text-dim);
}
.data-hint {
  font-size: 18rpx;
  color: #cbd5e1;
}
.price {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--gp-price);
  letter-spacing: -0.5rpx;
}
.actions {
  padding: 12rpx 20rpx 20rpx;
  display: flex;
  gap: 12rpx;
}
.act-btn {
  flex: 1;
  margin: 0;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 14rpx;
}
.act-ghost {
  background: #ffffff;
  color: var(--gp-primary);
  border: 1rpx solid #c7d2fe;
}
.act-btn-on {
  color: var(--gp-text-dim);
  border-color: var(--gp-border);
}
.act-primary {
  background: linear-gradient(135deg, #6366f1, #0891b2);
  color: #ffffff;
}
