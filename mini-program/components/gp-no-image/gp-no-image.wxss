/* 中性空态：通用"图片缺失"图标（相框+斜杠），与任何商品类别无关 */
.gp-no-image {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: #cbd5e1;
  width: 100%;
  height: 100%;
}
.icon-wrap {
  position: relative;
}
.pie-frame {
  position: absolute;
  left: 0;
  top: 8%;
  border: 4rpx solid #cbd5e1;
  border-radius: 8rpx;
  box-sizing: border-box;
}
.pie-slash {
  position: absolute;
  left: 50%;
  top: 0;
  width: 4rpx;
  background: #cbd5e1;
  transform: translateX(-50%) rotate(40deg);
  border-radius: 2rpx;
}
.text {
  font-size: 20rpx;
  color: #9ca3af;
  letter-spacing: 2rpx;
}
