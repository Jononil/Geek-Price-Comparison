/* ============================================================
   全局主题：与 PC 用户端 v2 视觉规范同步
   ------------------------------------------------------------
   对照 frontend/src/styles/global.css：
   - 主色 #4f46e5（靛蓝）/ 辅助 #0891b2（青）/ 背景 #f5f7fa
   - 卡片白底 + 阴影（0 2px 4px + 0 16px 48px/-24px）
   - 文字 #1f2937 / #6b7280 / #9ca3af（三级）
   - 价格近黑加粗（PC 用 #111827 大字），性价比绿 #15803d，降价琥珀 #b45309
   - 圆角：卡片 32rpx（16px）、按钮/输入 20rpx、标签 12rpx、胶囊 999rpx
   移动端换算：1px = 2rpx
   ============================================================ */
page {
  /* ---- 颜色 ---- */
  --gp-primary: #4f46e5;
  --gp-primary-light: #eef2ff;
  --gp-primary-dark: #4338ca;
  --gp-cyan: #0891b2;

  --gp-bg: #f5f7fa;
  --gp-card-bg: #ffffff;
  --gp-border: #e5e7eb;
  --gp-divider: #f1f5f9;

  --gp-text-main: #1f2937;
  --gp-text-sub: #6b7280;
  --gp-text-dim: #9ca3af;

  --gp-price: #111827;     /* 价格：PC 已改为近黑大字 */
  --gp-value: #15803d;     /* 性价比 */
  --gp-danger: #dc2626;
  --gp-warning: #b45309;   /* 降价 / 提示 */

  /* ---- 字号 ---- */
  --gp-font-xs: 20rpx;
  --gp-font-sm: 24rpx;
  --gp-font-md: 28rpx;
  --gp-font-lg: 32rpx;
  --gp-font-xl: 40rpx;

  /* ---- 圆角 ---- */
  --gp-radius-sm: 12rpx;
  --gp-radius-md: 20rpx;
  --gp-radius: 32rpx;

  /* ---- 间距 ---- */
  --gp-page-pad: 24rpx;
  --gp-gap: 24rpx;
  --gp-gap-sm: 16rpx;

  /* ---- 控件尺寸 ---- */
  --gp-btn-h: 88rpx;
  --gp-btn-h-sm: 64rpx;
  --gp-input-h: 88rpx;

  /* ---- 阴影 ---- */
  --gp-shadow: 0 4rpx 8rpx rgba(16, 24, 40, 0.06), 0 32rpx 96rpx -48rpx rgba(16, 24, 40, 0.18);

  background-color: var(--gp-bg);
  color: var(--gp-text-main);
  font-size: var(--gp-font-md);
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

button {
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: inherit;
  font-size: inherit;
  box-sizing: border-box;
}
button::after {
  border: none;
}

/* ---- 卡片：白底 + 阴影 + 32rpx 圆角 ---- */
.gp-card {
  background: var(--gp-card-bg);
  border: 1rpx solid var(--gp-border);
  border-radius: var(--gp-radius);
  padding: var(--gp-gap);
  box-shadow: var(--gp-shadow);
}

/* ---- 深色 Hero（首页/详情头部） ---- */
.gp-hero {
  /* 兜底：若多层渐变不被支持，至少保证深色底不出现白字白底 */
  background: #0e1729;
  background:
    radial-gradient(560rpx 360rpx at 10% -20%, rgba(79, 70, 229, 0.55), rgba(79, 70, 229, 0)),
    radial-gradient(520rpx 340rpx at 92% 4%, rgba(8, 145, 178, 0.42), rgba(8, 145, 178, 0)),
    linear-gradient(160deg, #0b1220 0%, #111c33 46%, #0e1729 100%);
  border-radius: var(--gp-radius);
  padding: 40rpx 32rpx;
  color: #e8edf7;
}

.gp-hero-title {
  display: block;
  font-size: 48rpx;
  line-height: 1.25;
  font-weight: 800;
  letter-spacing: -0.5rpx;
  color: #ffffff;
}

.gp-hero-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #b9c4d8;
}

/* ---- 眉标（区块上方的小标签） ---- */
.gp-kicker {
  display: block;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  font-weight: 700;
  color: var(--gp-primary);
  margin-bottom: 6rpx;
}
.gp-hero .gp-kicker {
  display: inline-block;
  color: #a5b4fc;
  background: rgba(165, 180, 252, 0.12);
  border: 1rpx solid rgba(165, 180, 252, 0.32);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  letter-spacing: 1rpx;
}

.gp-section-title {
  font-size: var(--gp-font-lg);
  font-weight: 700;
  color: var(--gp-text-main);
}

/* ---- 胶囊筛选（分类/排序） ---- */
.gp-chip {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--gp-border);
  background: #ffffff;
  color: #4b5563;
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
}
.gp-chip-on {
  background: var(--gp-primary);
  border-color: var(--gp-primary);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx -10rpx rgba(79, 70, 229, 0.9);
}

/* ---- 按钮 ---- */
.gp-btn-primary,
.gp-btn-ghost {
  display: block;
  height: var(--gp-btn-h);
  line-height: var(--gp-btn-h);
  font-size: var(--gp-font-md);
  font-weight: 600;
  border-radius: var(--gp-radius-md);
  text-align: center;
  padding: 0 40rpx;
  box-sizing: border-box;
}
.gp-btn-primary {
  background: linear-gradient(135deg, #6366f1, #0891b2);
  color: #ffffff;
  box-shadow: 0 12rpx 32rpx -16rpx rgba(99, 102, 241, 0.9);
}
.gp-btn-ghost {
  background: #ffffff;
  color: var(--gp-primary);
  border: 1rpx solid #c7d2fe;
}
.gp-btn-primary.btn-disabled,
.gp-btn-ghost.btn-disabled {
  opacity: 0.5;
}
.gp-btn-sm {
  height: var(--gp-btn-h-sm);
  line-height: var(--gp-btn-h-sm);
  font-size: var(--gp-font-sm);
  padding: 0 28rpx;
}

/* ---- 标签 ---- */
.gp-tag {
  display: inline-block;
  font-size: 22rpx;
  line-height: 1.4;
  padding: 4rpx 16rpx;
  border-radius: var(--gp-radius-sm);
  white-space: nowrap;
}
.gp-tag-blue {
  background: var(--gp-primary-light);
  color: var(--gp-primary);
}
.gp-tag-green {
  background: #ecfdf5;
  color: var(--gp-value);
  border: 1rpx solid #bbf7d0;
}
.gp-tag-gray {
  background: #f3f4f6;
  color: var(--gp-text-sub);
}
.gp-tag-orange {
  background: #fffbeb;
  color: var(--gp-warning);
  border: 1rpx solid #fde68a;
}
.gp-pill {
  display: inline-block;
  font-size: var(--gp-font-sm);
  line-height: 1.5;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
}

/* ---- 价格 ---- */
.gp-price {
  color: var(--gp-price);
  font-weight: 800;
}

/* ---- 数据来源提示 ---- */
.gp-data-hint {
  font-size: var(--gp-font-xs);
  color: var(--gp-text-dim);
  letter-spacing: 1rpx;
}

/* ---- 输入框 ---- */
.gp-input {
  height: var(--gp-input-h);
  border: 1rpx solid var(--gp-border);
  border-radius: var(--gp-radius-md);
  padding: 0 28rpx;
  font-size: var(--gp-font-md);
  background: #fafafa;
  box-sizing: border-box;
}
